---
const projects = [
  {
    id: 1,
    title: 'Lumina Rebrand',
    category: 'Brand Identity',
    year: '2024',
    span: 'wide',
    gradient: 'linear-gradient(135deg, #0d1117 0%, #1c2a4a 50%, #0a1628 100%)',
    accent: '#4f8ef7',
  },
  {
    id: 2,
    title: 'Orbit Finance',
    category: 'Web Design',
    year: '2024',
    span: 'tall',
    gradient: 'linear-gradient(150deg, #0f0f0f 0%, #1a1226 60%, #0e0a1a 100%)',
    accent: '#9b6dff',
  },
  {
    id: 3,
    title: 'Forma Studio',
    category: 'UI / UX',
    year: '2023',
    span: 'normal',
    gradient: 'linear-gradient(120deg, #0a1a10 0%, #0d2b18 60%, #071208 100%)',
    accent: '#4ecc8a',
  },
  {
    id: 4,
    title: 'Pulse Motion',
    category: 'Motion Design',
    year: '2023',
    span: 'normal',
    gradient: 'linear-gradient(140deg, #1a0a0a 0%, #2b0d0d 60%, #120505 100%)',
    accent: '#ff5e5e',
  },
  {
    id: 5,
    title: 'Apex Commerce',
    category: 'Development',
    year: '2023',
    span: 'wide',
    gradient: 'linear-gradient(130deg, #0c0a08 0%, #1f1810 60%, #0e0d09 100%)',
    accent: '#f0a644',
  },
];
---

<section class="portfolio">
  <div class="container">

    <!-- Header -->
    <div class="portfolio__header">
      <div>
        <span class="label" data-reveal>Selected Work</span>
        <h2 class="portfolio__title" data-split-words>Projects we're<br />proud of</h2>
      </div>
      <a href="/portfolio" class="btn btn--ghost" data-reveal data-delay="0.2">
        All Projects
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- Grid -->
    <div class="portfolio__grid" data-stagger-group>
      {projects.map(({ id, title, category, year, span, gradient, accent }) => (
        <article
          class={`portfolio-item portfolio-item--${span}`}
          data-stagger-item
        >
          <a href={`/portfolio/${id}`} class="portfolio-item__link" aria-label={`View project: ${title}`}>

            <!-- Background image / colour fill -->
            <div class="portfolio-item__bg" style={`background: ${gradient}`}>
              <div class="portfolio-item__accent" style={`background: ${accent}`}></div>
            </div>

            <!-- Overlay -->
            <div class="portfolio-item__overlay">
              <span class="portfolio-item__view">View Project ↗</span>
            </div>

            <!-- Meta -->
            <footer class="portfolio-item__meta">
              <h3 class="portfolio-item__title">{title}</h3>
              <div class="portfolio-item__sub">
                <span>{category}</span>
                <span>{year}</span>
              </div>
            </footer>

          </a>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .portfolio {
    padding-block: var(--section-py);
    border-top: 1px solid var(--clr-border);
  }

  /* ─── Header ─────────────────────────────────────────────── */
  .portfolio__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .portfolio__title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 400;
    color: var(--clr-text);
    letter-spacing: -0.03em;
    line-height: 1;
    margin-top: 1rem;
    overflow: hidden;
  }

  /* ─── Grid ───────────────────────────────────────────────── */
  .portfolio__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: 280px;
    gap: 1rem;
  }

  .portfolio-item        { grid-column: span 4; }
  .portfolio-item--wide  { grid-column: span 8; }
  .portfolio-item--tall  { grid-row: span 2; }

  /* ─── Card ───────────────────────────────────────────────── */
  .portfolio-item__link {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    cursor: pointer;
  }

  .portfolio-item__bg {
    position: absolute;
    inset: -5%;
    transition: transform 0.8s var(--ease-out);
  }

  .portfolio-item:hover .portfolio-item__bg {
    transform: scale(1.04);
  }

  .portfolio-item__accent {
    position: absolute;
    bottom: -20%;
    right: -10%;
    width: 45%;
    height: 45%;
    border-radius: 50%;
    opacity: 0.15;
    filter: blur(60px);
    transition: opacity 0.6s;
  }

  .portfolio-item:hover .portfolio-item__accent {
    opacity: 0.3;
  }

  /* Overlay */
  .portfolio-item__overlay {
    position: absolute;
    inset: 0;
    background: rgba(6, 6, 6, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
    backdrop-filter: blur(2px);
  }

  .portfolio-item:hover .portfolio-item__overlay { opacity: 1; }

  .portfolio-item__view {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--clr-text);
    padding: 0.6rem 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    transition: background var(--dur), border-color var(--dur);
  }

  .portfolio-item:hover .portfolio-item__view {
    background: var(--clr-accent);
    color: var(--clr-bg);
    border-color: var(--clr-accent);
  }

  /* Meta */
  .portfolio-item__meta {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem;
    background: linear-gradient(to top, rgba(6,6,6,0.85) 0%, transparent 100%);
  }

  .portfolio-item__title {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.5vw, 1.35rem);
    font-weight: 400;
    color: var(--clr-text);
    letter-spacing: -0.02em;
    margin-bottom: 0.3rem;
  }

  .portfolio-item__sub {
    display: flex;
    gap: 1rem;
    font-size: 0.72rem;
    color: rgba(240, 237, 232, 0.5);
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
  }

  /* ─── Responsive ─────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .portfolio__grid { grid-template-columns: repeat(6, 1fr); }
    .portfolio-item--wide { grid-column: span 6; }
    .portfolio-item { grid-column: span 3; }
  }

  @media (max-width: 640px) {
    .portfolio__grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 220px;
    }
    .portfolio-item,
    .portfolio-item--wide,
    .portfolio-item--tall { grid-column: span 1; grid-row: span 1; }
    .portfolio__header { flex-direction: column; align-items: flex-start; }
  }
</style>
