---
import { getCollection } from "astro:content";

const projects = (await getCollection("portfolio"))
    .sort((a, b) => a.data.order - b.data.order)
    .slice(0, 3);
---

<section class="portfolio">
    <div class="container">
        <div class="portfolio__header">
            <div>
                <h2 class="portfolio__title" data-split-words>
                    Selected work.
                </h2>
                <p class="portfolio__intro" data-reveal>
                    A growing list of live projects, starting with the work
                    already completed.
                </p>
            </div>
            <a
                href="/portfolio"
                class="btn btn--ghost"
                data-reveal
                data-delay="0.2"
            >
                View All Work
                <svg
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                    aria-hidden="true"
                >
                    <path
                        d="M3 8h10M9 4l4 4-4 4"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                </svg>
            </a>
        </div>

        <div class="portfolio__grid" data-stagger-group>
            {
                projects.map((project) => (
                    <article class="portfolio-item" data-stagger-item>
                        <a
                            href={project.data.website}
                            target="_blank"
                            rel="noreferrer"
                            class="portfolio-item__link"
                            aria-label={`Visit ${project.data.title}`}
                        >
                            <div class="portfolio-item__surface">
                                <div class="portfolio-item__top">
                                    <span class="portfolio-item__status">
                                        {project.data.status}
                                    </span>
                                    <span class="portfolio-item__visit">
                                        Visit site
                                    </span>
                                </div>

                                <div class="portfolio-item__content">
                                    <p class="portfolio-item__client">
                                        {project.data.client}
                                    </p>
                                    <h3 class="portfolio-item__title-sm">
                                        {project.data.title}
                                    </h3>
                                    <p class="portfolio-item__desc">
                                        {project.data.description}
                                    </p>
                                </div>

                                <ul class="portfolio-item__services">
                                    {project.data.services.map((service) => (
                                        <li>{service}</li>
                                    ))}
                                </ul>
                            </div>
                        </a>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .portfolio {
        padding-block: var(--section-py);
        border-top: 1px solid var(--clr-border);
    }

    .portfolio__header {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) auto;
        gap: 2rem;
        align-items: end;
        margin-bottom: clamp(3rem, 6vw, 4.5rem);
    }

    .portfolio__title {
        font-size: clamp(2.5rem, 5vw, 4.5rem);
        font-weight: 400;
        color: var(--clr-text);
        letter-spacing: -0.03em;
        line-height: 1;
        overflow: hidden;
        text-wrap: balance;
    }

    .portfolio__intro {
        margin-top: 1rem;
        max-width: 40ch;
        font-size: 0.96rem;
        line-height: 1.75;
        color: var(--clr-text-2);
    }

    .portfolio__grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1rem;
    }

    .portfolio-item__link {
        display: block;
        height: 100%;
    }

    .portfolio-item__surface {
        height: 100%;
        min-height: 340px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 2rem;
        padding: clamp(1.5rem, 3vw, 2rem);
        border: 1px solid var(--clr-border);
        border-radius: var(--radius-lg);
        background: linear-gradient(
            180deg,
            var(--clr-surface) 0%,
            rgba(15, 15, 15, 0.6) 100%
        );
        transition:
            transform var(--dur) var(--ease-out),
            border-color var(--dur) var(--ease-out),
            background var(--dur) var(--ease-out);
    }

    .portfolio-item__link:hover .portfolio-item__surface {
        transform: translateY(-4px);
        border-color: var(--clr-border-2);
        background: linear-gradient(
            180deg,
            var(--clr-surface-2) 0%,
            rgba(24, 24, 24, 0.82) 100%
        );
    }

    .portfolio-item__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .portfolio-item__status,
    .portfolio-item__visit,
    .portfolio-item__services li {
        font-size: 0.72rem;
        color: var(--clr-text-3);
    }

    .portfolio-item__visit {
        transition: color var(--dur) var(--ease-out);
    }

    .portfolio-item__link:hover .portfolio-item__visit {
        color: var(--clr-text);
    }

    .portfolio-item__client {
        max-width: 30ch;
        font-size: 0.88rem;
        line-height: 1.65;
        color: var(--clr-text-2);
        margin-bottom: 1rem;
    }

    .portfolio-item__title-sm {
        font-size: clamp(1.4rem, 2vw, 1.9rem);
        font-weight: 400;
        letter-spacing: -0.02em;
        margin-bottom: 0.75rem;
    }

    .portfolio-item__desc {
        max-width: 40ch;
        font-size: 0.92rem;
        line-height: 1.75;
        color: var(--clr-text-2);
    }

    .portfolio-item__services {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
    }

    .portfolio-item__services li {
        padding: 0.38rem 0.78rem;
        border: 1px solid var(--clr-border-2);
        border-radius: var(--radius-full);
    }

    @media (max-width: 760px) {
        .portfolio__header {
            grid-template-columns: 1fr;
            align-items: start;
        }
    }
</style>
