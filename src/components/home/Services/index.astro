---
import { services } from "../../../data/services";

const featuredServices = services.slice(0, 4);
---

<section class="services">
    <div class="container">
        <div class="services__header">
            <h2 class="services__title" data-split-words>
                Development services built for clarity and momentum.
            </h2>
            <p class="services__intro" data-reveal>
                From new websites to SEO and automation, we build digital
                systems that are straightforward to use and easy to maintain.
            </p>
        </div>

        <div class="services__grid" data-stagger-group>
            {
                featuredServices.map(({ title, description, includes }) => (
                    <article class="service-card" data-stagger-item>
                        <h3 class="service-card__title">{title}</h3>
                        <p class="service-card__desc">{description}</p>
                        <ul
                            class="service-card__tags"
                            aria-label="Included services"
                        >
                            {includes.map((item) => (
                                <li>{item}</li>
                            ))}
                        </ul>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .services {
        padding-block: var(--section-py);
        border-top: 1px solid var(--clr-border);
    }

    .services__header {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(260px, 0.8fr);
        gap: 2rem;
        align-items: end;
        margin-bottom: clamp(3rem, 6vw, 5rem);
    }

    .services__title {
        font-size: clamp(2.5rem, 5vw, 4.5rem);
        font-weight: 400;
        color: var(--clr-text);
        line-height: 1;
        letter-spacing: -0.03em;
        overflow: hidden;
        max-width: 11ch;
        text-wrap: balance;
    }

    .services__intro {
        max-width: 34ch;
        justify-self: end;
        font-size: 0.96rem;
        line-height: 1.75;
        color: var(--clr-text-2);
    }

    .services__grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1px;
        background: var(--clr-border);
        border: 1px solid var(--clr-border);
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    .service-card {
        background: var(--clr-bg);
        padding: clamp(2rem, 4vw, 3rem);
        display: flex;
        flex-direction: column;
        gap: 1rem;
        transition: background var(--dur) var(--ease-out);
    }

    .service-card:hover {
        background: var(--clr-surface);
    }

    .service-card__title {
        font-family: var(--font-display);
        font-size: clamp(1.35rem, 2vw, 1.75rem);
        font-weight: 400;
        color: var(--clr-text);
        letter-spacing: -0.02em;
        max-width: 15ch;
    }

    .service-card__desc {
        font-size: 0.9rem;
        color: var(--clr-text-2);
        line-height: 1.7;
        flex: 1;
        max-width: 38ch;
    }

    .service-card__tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-top: 0.4rem;
    }

    .service-card__tags li {
        font-size: 0.72rem;
        color: var(--clr-text-3);
        padding: 0.35rem 0.75rem;
        border: 1px solid var(--clr-border-2);
        border-radius: var(--radius-full);
    }

    @media (max-width: 900px) {
        .services__header {
            grid-template-columns: 1fr;
            align-items: start;
        }

        .services__intro {
            justify-self: start;
        }
    }

    @media (max-width: 640px) {
        .services__grid {
            grid-template-columns: 1fr;
        }
    }
</style>
