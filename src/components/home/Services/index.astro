---
const services = [
    {
        num: "01",
        title: "Brand Identity",
        desc: "We craft memorable visual identities — from logo systems to full brand guidelines — that communicate who you are with clarity and confidence.",
        tags: ["Logo Design", "Visual Identity", "Brand Guidelines"],
    },
    {
        num: "02",
        title: "Web Design & Development",
        desc: "Pixel-perfect websites with smooth interactions, built for performance. We bridge the gap between beautiful design and clean, accessible code.",
        tags: ["UI Design", "Astro / React", "Interaction Design"],
    },
    {
        num: "03",
        title: "Motion & Interaction",
        desc: "Purposeful animation that brings interfaces to life. From micro-interactions to full-page experiences, motion is our native language.",
        tags: ["GSAP", "After Effects", "Lottie"],
    },
    {
        num: "04",
        title: "Digital Strategy",
        desc: "We partner with you to map out the digital experience — understanding your audience, defining goals, and charting the path forward.",
        tags: ["UX Research", "Content Strategy", "Analytics"],
    },
];
---

<section class="services">
    <div class="container">
        <!-- Header -->
        <div class="services__header">
            <span class="label" data-reveal>What We Do</span>
            <h2 class="services__title" data-split-words>
                End-to-end creative<br />solutions
            </h2>
        </div>

        <!-- Grid -->
        <div class="services__grid" data-stagger-group>
            {
                services.map(({ num, title, desc, tags }) => (
                    <article class="service-card" data-stagger-item>
                        <header class="service-card__header">
                            <span class="service-card__num">{num}</span>
                            <span
                                class="service-card__arrow"
                                aria-hidden="true"
                            >
                                ↗
                            </span>
                        </header>
                        <h3 class="service-card__title">{title}</h3>
                        <p class="service-card__desc">{desc}</p>
                        <ul
                            class="service-card__tags"
                            aria-label="Technologies and skills"
                        >
                            {tags.map((tag) => (
                                <li>{tag}</li>
                            ))}
                        </ul>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .services {
        padding-block: var(--section-py);
        border-top: 1px solid var(--clr-border);
    }

    /* ─── Header ─────────────────────────────────────────────── */
    .services__header {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin-bottom: clamp(3rem, 6vw, 5rem);
    }

    .services__title {
        font-size: clamp(2.5rem, 5vw, 4.5rem);
        font-weight: 400;
        color: var(--clr-text);
        line-height: 1;
        letter-spacing: -0.03em;
        overflow: hidden;
    }

    /* ─── Grid ───────────────────────────────────────────────── */
    .services__grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1px;
        background: var(--clr-border);
        border: 1px solid var(--clr-border);
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    /* ─── Card ───────────────────────────────────────────────── */
    .service-card {
        background: var(--clr-bg);
        padding: clamp(2rem, 4vw, 3rem);
        display: flex;
        flex-direction: column;
        gap: 1rem;
        transition: background var(--dur) var(--ease-out);
        cursor: default;
    }

    .service-card:hover {
        background: var(--clr-surface);
    }

    .service-card__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .service-card__num {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        color: var(--clr-accent);
    }

    .service-card__arrow {
        font-size: 1.25rem;
        color: var(--clr-text-3);
        transition:
            color var(--dur) var(--ease-out),
            transform var(--dur) var(--ease-out);
    }

    .service-card:hover .service-card__arrow {
        color: var(--clr-accent);
        transform: translate(2px, -2px);
    }

    .service-card__title {
        font-family: var(--font-display);
        font-size: clamp(1.35rem, 2vw, 1.75rem);
        font-weight: 400;
        color: var(--clr-text);
        letter-spacing: -0.02em;
    }

    .service-card__desc {
        font-size: 0.9rem;
        color: var(--clr-text-2);
        line-height: 1.7;
        flex: 1;
    }

    .service-card__tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.5rem;
    }

    .service-card__tags li {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        letter-spacing: 0.06em;
        color: var(--clr-text-3);
        padding: 0.3rem 0.7rem;
        border: 1px solid var(--clr-border-2);
        border-radius: var(--radius-full);
        transition:
            border-color var(--dur) var(--ease-out),
            color var(--dur) var(--ease-out);
    }

    .service-card:hover .service-card__tags li {
        border-color: var(--clr-border-2);
        color: var(--clr-text-2);
    }

    /* ─── Responsive ─────────────────────────────────────────── */
    @media (max-width: 640px) {
        .services__grid {
            grid-template-columns: 1fr;
        }
    }
</style>
