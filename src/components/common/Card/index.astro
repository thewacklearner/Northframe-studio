---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!-- Component: Card -->
<div class="bg-white rounded-xl shadow-md p-6 flex flex-col gap-3 border border-gray-100 hover:shadow-lg transition-shadow duration-200">
  <h3 class="text-lg font-semibold text-gray-900">{title}</h3>
  {description && (
    <p class="text-gray-500 text-sm leading-relaxed">{description}</p>
  )}
  <div class="mt-auto">
    <slot />
  </div>
</div>
