---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center' | 'right';
}

const { title, subtitle, align = 'center' } = Astro.props;

const alignClasses: Record<string, string> = {
  left: 'text-left',
  center: 'text-center',
  right: 'text-right',
};

const alignClass = alignClasses[align];
---

<!-- Component: SectionHeading -->
<div class={`mb-12 ${alignClass}`}>
  <h2 class="text-3xl font-bold text-gray-900 tracking-tight sm:text-4xl">{title}</h2>
  {subtitle && (
    <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">{subtitle}</p>
  )}
</div>
